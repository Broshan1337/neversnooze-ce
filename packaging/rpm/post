#!/bin/sh
set -e

ldconfig || true

if command -v setcap >/dev/null 2>&1; then
    for bin in /usr/bin/neversnooze-ce /usr/bin/cescan; do
        if [ -x "$bin" ]; then
            setcap cap_sys_ptrace+ep "$bin" 2>/dev/null \
                || echo "neversnooze-ce: could not setcap $bin (memory access will need root)." >&2
        fi
    done
else
    echo "neversnooze-ce: 'setcap' not found (install libcap). Neversnooze CE" >&2
    echo "  will need root, or kernel.yama.ptrace_scope=0, to read other processes." >&2
fi

exit 0
