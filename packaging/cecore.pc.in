prefix=${pcfiledir}/@CECORE_PC_PREFIX_FROM_PCDIR@
exec_prefix=${prefix}
libdir=${prefix}/@CMAKE_INSTALL_LIBDIR@
includedir=${prefix}/@CMAKE_INSTALL_INCLUDEDIR@

Name: cecore
Description: Neversnooze CE core engine (memory scan, debug, inject)
Version: @PROJECT_VERSION@
Libs: -L${libdir} -lcecore
Libs.private: -ldl -lpthread -lz
Cflags: -I${includedir}/cecore
